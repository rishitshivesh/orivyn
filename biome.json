{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.venv",
      "!**/pnpm-lock.yaml",
      "!**/.turbo",
      "!**/.turbo/**",
      "!**/.git",
      "!**/.git/**",
      "!**/diagnostics",
      "!**/diagnostics/**",
      "!**/*.tsbuildinfo"
    ]
  }
}
