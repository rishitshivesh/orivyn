ORIVYN_INFERENCE_PROVIDER=disabled
ORIVYN_API_KEY=
ORIVYN_ALLOWED_ORIGINS=http://localhost:3000
ORIVYN_MAX_INPUT_CHARS=2000
ORIVYN_MAX_TOOLS=20
CACTUS_TELEMETRY=0

# Opt-in conversational model. Key belongs on API server only.
ORIVYN_CHAT_PROVIDER=disabled
ORIVYN_CHAT_BASE_URL=https://api.openai.com/v1
ORIVYN_CHAT_API_KEY=
ORIVYN_CHAT_MODEL=
ORIVYN_CHAT_MAX_OUTPUT_TOKENS=1024
ORIVYN_CHAT_TOKEN_PARAMETER=max_tokens
ORIVYN_CHAT_TIMEOUT_SECONDS=60
# Only for your trusted local model server, not production external URLs.
ORIVYN_CHAT_ALLOW_INSECURE_LOCAL=false
